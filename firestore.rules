rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all users for testing purposes
    // IMPORTANT: Change these rules before deploying to production
    match /{document=**} {
      allow read, write: if true;
    }
    
